{
  "name": "sre-incident-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only incident agent for a k3s cluster: firing alert -> read-only investigation -> triage report -> issue for human review.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sre-agent": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check:links": "node scripts/check-links.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "replay": "node --env-file-if-exists=.env --import tsx scripts/replay.ts",
    "grade": "node --env-file-if-exists=.env --import tsx scripts/grade.ts",
    "sub:triage": "node --env-file-if-exists=.env --import tsx src/sub/run.ts",
    "sub:poll": "node --env-file-if-exists=.env --import tsx src/sub/poll.ts",
    "audit:rbac": "node --import tsx scripts/kube-identity-audit.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
