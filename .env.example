# sre-incident-agent configuration. Copy to .env and fill in. Never commit .env.
# Every value below is a placeholder.

# --- Cluster (read-only) ---------------------------------------------------
# A kubeconfig for a view-scoped, namespaced ServiceAccount. Never an admin one.
KUBECONFIG=/var/lib/sre-agent/kubeconfig
KUBE_CONTEXT=example-cluster
# Absolute path to kubectl, resolved once at config load.
KUBECTL_BIN=/usr/local/bin/kubectl
# Required in local-engine mode: the API server as an address literal.
KUBE_SERVER=https://192.0.2.10:6443

# --- Metrics, GitOps state and runbooks (read-only tokens) ------------------
GRAFANA_URL=https://grafana.example.com
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_PROM_DATASOURCE_UID=
ARGOCD_URL=https://argocd.example.com
ARGOCD_TOKEN=
# Runbook and ADR search over the docs/ trees of the platform repositories.
FORGEJO_URL=https://git.example.com
FORGEJO_TOKEN=

# --- Subscription mode (Claude via `claude -p`; no API key) -----------------
SRE_SUB_CLAUDE_BIN=/usr/local/bin/claude
SRE_SUB_MODEL=sonnet
SRE_SUB_EFFORT=high
SRE_SUB_RUN_BUDGET_USD=1.50
SRE_SUB_MONTHLY_BUDGET_USD=15
SRE_SUB_MAX_RUNS_PER_POLL=2
SRE_SUB_POLL_COOLDOWN_HOURS=24
SRE_SUB_REJECT_BACKOFF_HOURS=24
# Local hours in which the poller may start runs, e.g. 23-07. Blank = always.
SRE_SUB_POLL_HOURS=23-07
# off | dry | live: file each published report as an issue.
SRE_SUB_ISSUES=off
# Where and as whom reports are filed. All five are required unless issues are off.
# The token itself is never stored here: it is read with `op read` at filing
# time, using a 1Password service-account token kept in the named Keychain item.
SRE_SUB_ISSUE_URL=https://git.example.com
SRE_SUB_ISSUE_REPO=platform/incidents
SRE_SUB_ISSUE_BOT=incident-bot
SRE_SUB_ISSUE_TOKEN_REF=op://<vault>/<item>/credential
SRE_SUB_ISSUE_KEYCHAIN_ITEM=sre-agent-op-sa

# --- API mode and the local-model evaluation bench -------------------------
# API mode (`npm run dev -- triage`, `npm run replay -- --live`).
ANTHROPIC_API_KEY=
# Local engine (`npm run replay -- --local`): an OpenAI-compatible endpoint on
# a local address, e.g. Ollama or LM Studio.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_NAME=
